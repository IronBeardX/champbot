{
	"name": "champbot",
	"main": "src/worker.py",
	// Dates from 2026-09-08 switch the runtime to Python 3.14; the project stays on 3.13.
	"compatibility_date": "2026-09-07",
	"compatibility_flags": [
		"python_workers"
	],
	"vars": {
		"GEMINI_MODEL": "gemini-3.6-flash",
		"RETRIEVAL_MIN_SCORE": "0.5"
	},
	"assets": {
		"directory": "../frontend/public"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "champbot-policies"
		}
	]
}