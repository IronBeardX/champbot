# Copy to .env and fill in the values.

# Which LLM backs /chat: gemini or groq. In production it is set in
# backend/wrangler.jsonc.
LLM_PROVIDER=gemini

# Gemini API key from Google AI Studio. In production it is a Worker secret.
GEMINI_API_KEY=your-gemini-api-key

# Gemini model id. In production it is set in backend/wrangler.jsonc.
GEMINI_MODEL=gemini-3.6-flash

# URL for Gemini's generateContent endpoint, with a {model} placeholder. In
# production it is set in backend/wrangler.jsonc.
GEMINI_GENERATE_CONTENT_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent

# Groq API key from the GroqCloud console. In production it is a Worker secret.
GROQ_API_KEY=your-groq-api-key

# Groq model id. In production it is set in backend/wrangler.jsonc.
GROQ_MODEL=your-groq-model-id

# URL for Groq's OpenAI-compatible chat completions endpoint. In production
# it is set in backend/wrangler.jsonc.
GROQ_GENERATE_CONTENT_URL=https://api.groq.com/openai/v1/chat/completions

# How hard Gemini thinks before answering /chat: MINIMAL, LOW, MEDIUM or HIGH.
# A routing and RAG call doesn't need deep reasoning. In production it is set
# in backend/wrangler.jsonc.
GEMINI_THINKING_LEVEL=LOW

# How hard Groq reasons before answering /chat: none, low, medium or high.
# Leave unset to use the model's default. In production it is set in
# backend/wrangler.jsonc.
GROQ_REASONING_EFFORT=

# Cloudflare account id, from the Workers & Pages overview in the dashboard
# (or `wrangler whoami`). Same value for every token below. In production it
# is a Worker secret.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Vectorize write + Workers AI run. Used only by the local champbot-ingest CLI.
CF_INGEST_API_TOKEN=your-cf-ingest-api-token

# Vectorize read + Workers AI run. In production it is a Worker secret; also
# used by the local retrieval evaluation CLI (backend/evals/retrieval.py).
CF_RUNTIME_API_TOKEN=your-cf-runtime-api-token

# Minimum Vectorize similarity score for a retrieved policy chunk to be used
# in /chat. In production it is set in backend/wrangler.jsonc.
RETRIEVAL_MIN_SCORE=0.5