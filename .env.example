# Copy to .env and fill in the values.

# Gemini API key from Google AI Studio. In production it is a Worker secret.
GEMINI_API_KEY=your-gemini-api-key

# Gemini model id. In production it is set in backend/wrangler.jsonc.
GEMINI_MODEL=gemini-3.6-flash

# How hard Gemini thinks before answering /chat: MINIMAL, LOW, MEDIUM or HIGH.
# A routing and RAG call doesn't need deep reasoning. In production it is set
# in backend/wrangler.jsonc.
GEMINI_THINKING_LEVEL=LOW

# Cloudflare account id, from the Workers & Pages overview in the dashboard
# (or `wrangler whoami`). Same value for every token below. In production it
# is a Worker secret.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Vectorize write + Workers AI run. Used only by the local champbot-ingest CLI.
CF_INGEST_API_TOKEN=your-cf-ingest-api-token

# Vectorize read + Workers AI run. In production it is a Worker secret.
CF_RUNTIME_API_TOKEN=your-cf-runtime-api-token

# Minimum Vectorize similarity score for a retrieved policy chunk to be used
# in /chat. In production it is set in backend/wrangler.jsonc.
RETRIEVAL_MIN_SCORE=0.5